+    @staticmethod
+    def _threshold_adjustment(
+        *,
+        current: float,
+        winrate: float,
+        avg_net_pnl: float,
+        low: float,
+        high: float,
+        step: float,
+    ) -> float | None:
+        proposed = current
+        if winrate < 0.45 or avg_net_pnl < 0.0:
+            proposed = min(high, current + step)
+        elif winrate > 0.58 and avg_net_pnl > 0.0:
+            proposed = max(low, current - step)
